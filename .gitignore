# Runtime artifacts can contain process addresses, screenshots, and large traces.
logs/

# Python caches and local environments.
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# Build/package output.
build/
dist/
*.egg-info/

# Local metadata-110 reverse JSON is generated evidence over GitHub's 100 MiB
# file limit. Keep the compact C# declarations and compatibility report in Git.
reverse/pokiguard_1.7.4/il2cppinspector/metadata.json

# b2 generated bulk stays local (il2cpp.json alone exceeds GitHub's file limit).
# Preserve the compact game declarations and provenance note in source control.
reverse/reverse_1.7.4-b2/*
!reverse/reverse_1.7.4-b2/cs/
reverse/reverse_1.7.4-b2/cs/*
!reverse/reverse_1.7.4-b2/cs/Assembly-CSharp/
!reverse/reverse_1.7.4-b2/README.md
# Preserve local reverse-input archives without treating them as source files.
reverse/reverse_1.7.4-b2.zip

# b3 generated bulk follows the same rule as b2. Keep the compact
# Assembly-CSharp declarations and provenance note available for review.
reverse/reverse_1.7.4-b3/*
!reverse/reverse_1.7.4-b3/cs/
reverse/reverse_1.7.4-b3/cs/*
!reverse/reverse_1.7.4-b3/cs/Assembly-CSharp/
!reverse/reverse_1.7.4-b3/README.md
reverse/reverse_1.7.4-b3.zip

# b4 generated bulk follows the same rule. Keep declarations and provenance.
reverse/reverse_1.7.4-b4/*
!reverse/reverse_1.7.4-b4/cs/
reverse/reverse_1.7.4-b4/cs/*
!reverse/reverse_1.7.4-b4/cs/Assembly-CSharp/
!reverse/reverse_1.7.4-b4/README.md
reverse/reverse_1.7.4-b4.zip

# Local editor and OS files.
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files.
temp/
*.tmp
*.temp
*.bak
*.swp
~$*
