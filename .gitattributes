# Generated reverse-engineering artifacts preserve the dumper's exact text.
# Do not apply source whitespace policy to these evidence-only trees.
reverse/pokiguard_1.7.4/** -whitespace
reverse/redux_compat/** -whitespace
reverse/reverse_1.7.4-b2/cs/Assembly-CSharp/** -whitespace

# Calibration/package identities pin exact Python bytes. Preserve each file's
# existing LF/CRLF bytes in Git rather than rewriting them on add/checkout.
*.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Replay manifests pin SHA256 of the raw JSONL. Windows checkout must not
# rewrite newlines in these evidence bytes.
*.jsonl -text

# Mega/Galaxy evidence and handoff manifests pin raw file SHA256 values.
# Preserve these bytes across Windows/Linux checkout, including linked reports.
tests/fixtures/*_20261124/** -text whitespace=blank-at-eol,space-before-tab,cr-at-eol
tests/fixtures/compatibility/active_skill_evidence_20261123.json -text whitespace=blank-at-eol,space-before-tab,cr-at-eol
tests/fixtures/compatibility/mega_swap_control_20261124.json -text whitespace=blank-at-eol,space-before-tab,cr-at-eol
docs/phase5/GALAXY_G*_NATIVE_*_20261124.md -text whitespace=blank-at-eol,space-before-tab,cr-at-eol
docs/phase5/MEGA_*_NATIVE_20261124.md -text whitespace=blank-at-eol,space-before-tab,cr-at-eol
docs/phase5/mega_galaxy_handoff_20261124/** -text whitespace=blank-at-eol,space-before-tab,cr-at-eol
